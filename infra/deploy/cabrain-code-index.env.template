# /opt/cabrain-code-index/env  — chmod 600, NEVER committed with real values.
# Consumed by cabrain-code-index.service (see scripts/code-index.py).
CABRAIN_API_URL=https://cabrain.fadymondy.com
CABRAIN_TOKEN=cbt_xxx                     # brain token with write access
CABRAIN_NAMESPACE=flowos
GITHUB_TOKEN=ghp_xxx                      # read access to the private org repos
REPOMIX_CMD=/opt/cabrain-code-index/node_modules/.bin/repomix
CODE_INDEX_CACHE=/opt/cabrain-code-index/repos
CODE_INDEX_STATE=/opt/cabrain-code-index/state.json
CODE_MAX_CHUNKS=80
DOC_MAX_CHUNKS=40
# Optional — when the brain DB is reachable, the run also writes the entity graph
# and soft-retires chunks whose files disappeared:
# CABRAIN_DSN=postgresql://cabrain:***@host:5432/cabrain
# FLOWOS_DSN=postgresql://flowos:***@host:5432/onestudio_hub   (READ ONLY, REPO_OF edges)
PATH=/opt/cabrain-code-index/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
